# Script mode: prepare the doxygen-awesome-css theme for the docs target.
#
#   cmake -DTHEME_DIR=<dir> -DTHEME_VERSION=<x.y.z> -DTHEME_SHA256=<hash> -DDOXYGEN=<doxygen> -P docs-theme.cmake
#
# Downloads the pinned release once (hash checked), copies its CSS/JS into THEME_DIR, and writes a
# header.html generated by this Doxygen version with the theme's extension scripts enabled.
#

foreach(_var THEME_DIR THEME_VERSION THEME_SHA256 DOXYGEN)
    if(NOT ${_var})
        message(FATAL_ERROR "docs-theme.cmake: ${_var} is required")
    endif()
endforeach()

execute_process(COMMAND "${DOXYGEN}" --version OUTPUT_VARIABLE _doxygen_version OUTPUT_STRIP_TRAILING_WHITESPACE)
set(_stamp "${THEME_DIR}/.theme-${THEME_VERSION}-doxygen-${_doxygen_version}")
if(EXISTS "${_stamp}")
    return()
endif()

file(REMOVE_RECURSE "${THEME_DIR}")
file(MAKE_DIRECTORY "${THEME_DIR}")

set(_url "https://github.com/jothepro/doxygen-awesome-css/archive/refs/tags/v${THEME_VERSION}.zip")
set(_zip "${THEME_DIR}/theme.zip")
message(STATUS "[Docs] Downloading doxygen-awesome-css v${THEME_VERSION}")
file(DOWNLOAD "${_url}" "${_zip}" STATUS _status EXPECTED_HASH SHA256=${THEME_SHA256} TLS_VERIFY ON)
list(GET _status 0 _code)
if(NOT _code EQUAL 0)
    list(GET _status 1 _msg)
    file(REMOVE_RECURSE "${THEME_DIR}")
    message(FATAL_ERROR "[Docs] Could not download ${_url}: ${_msg}\n"
        "Re-configure with -DIDICMAKE_DOCS_THEME=OFF to build plain Doxygen docs without the theme.")
endif()

set(_extract "${THEME_DIR}/extract")
file(ARCHIVE_EXTRACT INPUT "${_zip}" DESTINATION "${_extract}")
file(GLOB _theme_files
    "${_extract}/doxygen-awesome-css-${THEME_VERSION}/doxygen-awesome*.css"
    "${_extract}/doxygen-awesome-css-${THEME_VERSION}/doxygen-awesome*.js")
if(NOT _theme_files)
    message(FATAL_ERROR "[Docs] Unexpected layout in ${_url}")
endif()
file(COPY ${_theme_files} DESTINATION "${THEME_DIR}")
file(REMOVE_RECURSE "${_extract}" "${_zip}")

# Start from this Doxygen's default header so it matches the installed version, then enable the extensions.
execute_process(
    COMMAND "${DOXYGEN}" -w html "${THEME_DIR}/header.html" "${THEME_DIR}/_footer.html" "${THEME_DIR}/_style.css"
    WORKING_DIRECTORY "${THEME_DIR}"
    RESULT_VARIABLE _rc)
if(NOT _rc EQUAL 0)
    message(FATAL_ERROR "[Docs] '${DOXYGEN} -w html' failed (exit ${_rc})")
endif()
file(REMOVE "${THEME_DIR}/_footer.html" "${THEME_DIR}/_style.css")

file(READ "${THEME_DIR}/header.html" _header)
string(REPLACE "</head>" "<script type=\"text/javascript\" src=\"$relpath^doxygen-awesome-darkmode-toggle.js\"></script>
<script type=\"text/javascript\" src=\"$relpath^doxygen-awesome-fragment-copy-button.js\"></script>
<script type=\"text/javascript\" src=\"$relpath^doxygen-awesome-paragraph-link.js\"></script>
<script type=\"text/javascript\">
    DoxygenAwesomeDarkModeToggle.init()
    DoxygenAwesomeFragmentCopyButton.init()
    DoxygenAwesomeParagraphLink.init()
</script>
</head>" _header "${_header}")
file(WRITE "${THEME_DIR}/header.html" "${_header}")

file(TOUCH "${_stamp}")
message(STATUS "[Docs] Theme ready in ${THEME_DIR}")
