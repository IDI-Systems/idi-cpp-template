# Script mode steps of the guided framework update (cmake/idi/tools/update.{sh,bat}).
#
#   cmake -DMODE=stage -DROOT=<project> -DSTAGE_DIR=<empty temp dir>
#         -DSOURCE_KIND=url|file|folder [-DSOURCE=<url|archive|folder>] [-DREF=<branch|tag>]
#         [-DALLOW_DIRTY=ON] [-DFORCE=ON] -P update_workflow.cmake
#       Checks the git tree, fetches the update into STAGE_DIR/tree, prints what would change and the
#       changelog, and writes STAGE_DIR/status.txt (KEY=VALUE) and STAGE_DIR/paths.txt (managed paths).
#       STATUS is "available", "forced" or "up-to-date".
#
#   cmake -DMODE=apply -DROOT=<project> -DSTAGE_DIR=<dir> [-DFORCE=ON] -P update_workflow.cmake
#       Applies the staged update through the regular configure-time updater (folder mode).
#
#   cmake -DMODE=post -DROOT=<project> -DSTAGE_DIR=<dir> -P update_workflow.cmake
#       Runs from the *updated* framework: summarizes the change and prints manual steps and rollback.
#
# URL source: SOURCE is a URL in which {ref} is replaced by REF (default: master). Without SOURCE the
# IDI_TEMPLATE_UPDATE_URL environment variable is used, else the GitHub template repository.
#

cmake_minimum_required(VERSION 3.26)

set(_default_url "https://github.com/IDI-Systems/idi-cpp-template/archive/{ref}.zip")
# Paths managed by framework versions that predate managed_paths.cmake (<= 6.3.2)
set(_legacy_dirs "cmake/idi" "src/base" ".claude/skills/idi-cmake")
set(_legacy_files "CMakeLists.txt" "src/CMakeLists.txt" "lib/.gitignore")

foreach(_var ROOT STAGE_DIR MODE)
    if(NOT ${_var})
        message(FATAL_ERROR "update_workflow.cmake: ${_var} is required")
    endif()
endforeach()
file(TO_CMAKE_PATH "${ROOT}" ROOT)
file(TO_CMAKE_PATH "${STAGE_DIR}" STAGE_DIR)
set(_tree "${STAGE_DIR}/tree")

find_program(_git git)

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------
function(_read_versions DIR PREFIX)
    set(IDICMAKE_CPP_UPDATER_VERSION 0)
    set(IDICMAKE_ROOT_REQ_CML_V 0)
    set(IDICMAKE_SRC_REQ_CML_V 0)
    set(IDICMAKE_BASE_REQ_CML_V 0)
    include("${DIR}/cmake/idi/version.cmake")
    include("${DIR}/cmake/idi/updater/updater_version.cmake")
    set(${PREFIX}_VERSION "${IDICMAKE_CPP_FRAMEWORK_VERSION_MAJOR}.${IDICMAKE_CPP_FRAMEWORK_VERSION_MINOR}.${IDICMAKE_CPP_FRAMEWORK_VERSION_HOTFIX}" PARENT_SCOPE)
    set(${PREFIX}_MAJOR "${IDICMAKE_CPP_FRAMEWORK_VERSION_MAJOR}" PARENT_SCOPE)
    set(${PREFIX}_UPDATER "${IDICMAKE_CPP_UPDATER_VERSION}" PARENT_SCOPE)
    set(${PREFIX}_CML "${IDICMAKE_ROOT_REQ_CML_V}.${IDICMAKE_SRC_REQ_CML_V}.${IDICMAKE_BASE_REQ_CML_V}" PARENT_SCOPE)
endfunction()

function(_read_managed_paths DIR)
    set(IDICMAKE_UPDATER_MANAGED_DIRS ${_legacy_dirs})
    set(IDICMAKE_UPDATER_MANAGED_FILES ${_legacy_files})
    if(EXISTS "${DIR}/cmake/idi/updater/managed_paths.cmake")
        include("${DIR}/cmake/idi/updater/managed_paths.cmake")
    endif()
    set(MANAGED_DIRS "${IDICMAKE_UPDATER_MANAGED_DIRS}" PARENT_SCOPE)
    set(MANAGED_FILES "${IDICMAKE_UPDATER_MANAGED_FILES}" PARENT_SCOPE)
endfunction()

function(_read_project_name OUT_VAR)
    set(IDICMAKE_PROJECT_NAME "")
    if(EXISTS "${ROOT}/platform-config.cmake")
        include("${ROOT}/platform-config.cmake")
    endif()
    if(NOT IDICMAKE_PROJECT_NAME AND IDI_PROJECT_NAME)
        set(IDICMAKE_PROJECT_NAME "${IDI_PROJECT_NAME}")
    endif()
    set(${OUT_VAR} "${IDICMAKE_PROJECT_NAME}" PARENT_SCOPE)
endfunction()

function(_git_run OUT_VAR)
    execute_process(COMMAND "${_git}" ${ARGN} WORKING_DIRECTORY "${ROOT}"
        RESULT_VARIABLE _rc OUTPUT_VARIABLE _out ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
    set(${OUT_VAR} "${_out}" PARENT_SCOPE)
    set(${OUT_VAR}_RC "${_rc}" PARENT_SCOPE)
endfunction()

# Relative file list of a directory, skipping generated (*.out.*) files.
function(_list_files OUT_VAR DIR)
    set(_files "")
    if(IS_DIRECTORY "${DIR}")
        file(GLOB_RECURSE _files LIST_DIRECTORIES false RELATIVE "${DIR}" "${DIR}/*")
        list(FILTER _files EXCLUDE REGEX "\\.out\\.[^/]*$")
    endif()
    set(${OUT_VAR} "${_files}" PARENT_SCOPE)
endfunction()

# Print added/removed/changed files between the project's copy of a managed dir and the incoming one.
# MAP_FROM/MAP_TO rename a path segment in the incoming list (src/base/include/template_project -> <proj>).
function(_diff_dir LABEL LOCAL_DIR INCOMING_DIR MAP_FROM MAP_TO)
    _list_files(_local "${LOCAL_DIR}")
    _list_files(_incoming_raw "${INCOMING_DIR}")
    set(_incoming "")
    set(_map "")
    foreach(_f IN LISTS _incoming_raw)
        set(_mapped "${_f}")
        if(MAP_FROM AND NOT MAP_FROM STREQUAL MAP_TO)
            string(REPLACE "${MAP_FROM}" "${MAP_TO}" _mapped "${_f}")
        endif()
        list(APPEND _incoming "${_mapped}")
        string(MAKE_C_IDENTIFIER "${_mapped}" _key)
        set(_src_${_key} "${_f}")
    endforeach()

    set(_added "")
    set(_changed "")
    foreach(_f IN LISTS _incoming)
        string(MAKE_C_IDENTIFIER "${_f}" _key)
        if(NOT _f IN_LIST _local)
            list(APPEND _added "${_f}")
        else()
            file(SHA256 "${LOCAL_DIR}/${_f}" _a)
            file(SHA256 "${INCOMING_DIR}/${_src_${_key}}" _b)
            if(NOT _a STREQUAL _b)
                list(APPEND _changed "${_f}")
            endif()
        endif()
    endforeach()
    set(_removed "")
    foreach(_f IN LISTS _local)
        if(NOT _f IN_LIST _incoming)
            list(APPEND _removed "${_f}")
        endif()
    endforeach()

    list(LENGTH _added _na)
    list(LENGTH _changed _nc)
    list(LENGTH _removed _nr)
    if(_na EQUAL 0 AND _nc EQUAL 0 AND _nr EQUAL 0)
        message(NOTICE "  ${LABEL}/  unchanged")
        return()
    endif()
    message(NOTICE "  ${LABEL}/  ${_nc} changed, ${_na} new, ${_nr} removed")
    # Removed files come first and are never cut off: in a framework-owned folder they are usually
    # project files that were put in the wrong place and will be lost.
    foreach(_f IN LISTS _removed)
        message(NOTICE "      - ${_f}   <-- not in the incoming framework: will be DELETED")
    endforeach()
    set(_shown 0)
    foreach(_kind "~;${_changed}" "+;${_added}")
        list(POP_FRONT _kind _mark)
        foreach(_f IN LISTS _kind)
            if(_shown LESS 25)
                message(NOTICE "      ${_mark} ${_f}")
            endif()
            math(EXPR _shown "${_shown} + 1")
        endforeach()
    endforeach()
    if(_shown GREATER 25)
        math(EXPR _more "${_shown} - 25")
        message(NOTICE "      ... and ${_more} more")
    endif()
endfunction()

# Print changelog sections for versions newer than FROM (and not newer than TO).
function(_print_changelog FILE FROM TO)
    if(NOT EXISTS "${FILE}")
        message(NOTICE "  (no changelog in the incoming framework)")
        return()
    endif()
    file(READ "${FILE}" _text)
    string(REPLACE ";" "\\;" _text "${_text}")
    string(REPLACE "\n" ";" _lines "${_text}")
    set(_printing FALSE)
    set(_any FALSE)
    foreach(_line IN LISTS _lines)
        if(_line MATCHES "^## \\[?([0-9]+\\.[0-9]+\\.[0-9]+)")
            set(_v "${CMAKE_MATCH_1}")
            if(_v VERSION_GREATER FROM AND NOT _v VERSION_GREATER TO)
                set(_printing TRUE)
                set(_any TRUE)
            else()
                set(_printing FALSE)
            endif()
        elseif(_line MATCHES "^# ")
            set(_printing FALSE)
        endif()
        if(_printing)
            message(NOTICE "  ${_line}")
        endif()
    endforeach()
    if(NOT _any)
        message(NOTICE "  (no changelog entries between ${FROM} and ${TO})")
    endif()
endfunction()

function(_write_status)
    set(_content "")
    foreach(_pair IN LISTS ARGN)
        string(APPEND _content "${_pair}\n")
    endforeach()
    file(WRITE "${STAGE_DIR}/status.txt" "${_content}")
endfunction()

function(_read_status)
    file(STRINGS "${STAGE_DIR}/status.txt" _lines)
    foreach(_line IN LISTS _lines)
        if(_line MATCHES "^([A-Z_]+)=(.*)$")
            set(STATUS_${CMAKE_MATCH_1} "${CMAKE_MATCH_2}" PARENT_SCOPE)
        endif()
    endforeach()
endfunction()

# ---------------------------------------------------------------------------
# MODE=stage
# ---------------------------------------------------------------------------
if(MODE STREQUAL "stage")
    if(NOT EXISTS "${ROOT}/cmake/idi/version.cmake")
        message(FATAL_ERROR "${ROOT} does not look like an IDI CMake project (no cmake/idi/version.cmake)")
    endif()

    # Git safety: the update must be reviewable and revertible
    set(_in_git FALSE)
    if(_git)
        _git_run(_inside rev-parse --is-inside-work-tree)
        if(_inside_RC EQUAL 0 AND _inside STREQUAL "true")
            set(_in_git TRUE)
        endif()
    endif()
    if(NOT _in_git)
        if(NOT ALLOW_DIRTY)
            message(FATAL_ERROR "${ROOT} is not a git work tree (or git is not installed), so the update could not be "
                "reviewed or rolled back. Commit the project to git first, or pass --allow-dirty to update anyway.")
        endif()
        message(WARNING "Not a git work tree: the update cannot be rolled back with git.")
    else()
        _git_run(_dirty status --porcelain --untracked-files=normal)
        if(_dirty AND NOT ALLOW_DIRTY)
            string(REPLACE "\n" ";" _dirty_lines "${_dirty}")
            list(LENGTH _dirty_lines _n)
            list(SUBLIST _dirty_lines 0 10 _shown)
            list(JOIN _shown "\n    " _shown)
            message(FATAL_ERROR "The working tree has ${_n} uncommitted change(s):\n    ${_shown}\n"
                "Commit or stash them first so the update shows up as its own diff, or pass --allow-dirty.")
        endif()
    endif()

    _read_versions("${ROOT}" LOCAL)

    # Fetch
    file(REMOVE_RECURSE "${_tree}" "${STAGE_DIR}/extract")
    file(MAKE_DIRECTORY "${STAGE_DIR}")
    if(SOURCE_KIND STREQUAL "url" OR NOT SOURCE_KIND)
        if(NOT SOURCE)
            if(DEFINED ENV{IDI_TEMPLATE_UPDATE_URL} AND NOT "$ENV{IDI_TEMPLATE_UPDATE_URL}" STREQUAL "")
                set(SOURCE "$ENV{IDI_TEMPLATE_UPDATE_URL}")
            else()
                set(SOURCE "${_default_url}")
            endif()
        endif()
        if(NOT REF)
            set(REF "master")
        endif()
        string(REPLACE "{ref}" "${REF}" _url "${SOURCE}")
        message(NOTICE "Downloading ${_url}")
        file(DOWNLOAD "${_url}" "${STAGE_DIR}/download.zip" STATUS _status TLS_VERIFY ON)
        list(GET _status 0 _code)
        if(NOT _code EQUAL 0)
            list(GET _status 1 _msg)
            message(FATAL_ERROR "Download failed: ${_msg} (${_url}). Check the --ref/--url, or use --file / --folder.")
        endif()
        set(_archive "${STAGE_DIR}/download.zip")
        set(_source_desc "${_url}")
    elseif(SOURCE_KIND STREQUAL "file")
        get_filename_component(_archive "${SOURCE}" ABSOLUTE)
        if(NOT EXISTS "${_archive}")
            message(FATAL_ERROR "Archive not found: ${_archive}")
        endif()
        set(_source_desc "${_archive}")
    elseif(SOURCE_KIND STREQUAL "folder")
        get_filename_component(_folder "${SOURCE}" ABSOLUTE)
        if(NOT EXISTS "${_folder}/cmake/idi/updater/updater_version.cmake")
            message(FATAL_ERROR "${_folder} is not an IDI CMake template (no cmake/idi/updater/updater_version.cmake)")
        endif()
        if(_folder STREQUAL ROOT)
            message(FATAL_ERROR "--folder points at this project itself")
        endif()
        set(_source_desc "${_folder}")
    else()
        message(FATAL_ERROR "Unknown SOURCE_KIND '${SOURCE_KIND}' (url, file or folder)")
    endif()

    if(DEFINED _archive)
        file(ARCHIVE_EXTRACT INPUT "${_archive}" DESTINATION "${STAGE_DIR}/extract")
        set(_extracted "${STAGE_DIR}/extract")
        if(NOT EXISTS "${_extracted}/cmake/idi/updater/updater_version.cmake")
            file(GLOB _entries "${_extracted}/*")
            list(LENGTH _entries _n)
            if(_n EQUAL 1 AND IS_DIRECTORY "${_entries}")
                set(_extracted "${_entries}")
            endif()
        endif()
        if(NOT EXISTS "${_extracted}/cmake/idi/updater/updater_version.cmake")
            message(FATAL_ERROR "${_source_desc} does not contain an IDI CMake template")
        endif()
        file(RENAME "${_extracted}" "${_tree}")
        file(REMOVE_RECURSE "${STAGE_DIR}/extract" "${STAGE_DIR}/download.zip")
    else()
        # Only copy what the updater uses (plus the version files), not the whole template checkout
        _read_managed_paths("${_folder}")
        foreach(_d IN LISTS MANAGED_DIRS)
            if(IS_DIRECTORY "${_folder}/${_d}")
                get_filename_component(_parent "${_tree}/${_d}" DIRECTORY)
                file(MAKE_DIRECTORY "${_parent}")
                file(COPY "${_folder}/${_d}" DESTINATION "${_parent}")
            endif()
        endforeach()
        foreach(_f IN LISTS MANAGED_FILES)
            if(EXISTS "${_folder}/${_f}")
                get_filename_component(_parent "${_tree}/${_f}" DIRECTORY)
                file(MAKE_DIRECTORY "${_parent}")
                file(COPY_FILE "${_folder}/${_f}" "${_tree}/${_f}")
            endif()
        endforeach()
    endif()

    _read_versions("${_tree}" NEW)
    _read_managed_paths("${_tree}")
    _read_project_name(_project)

    set(_major_update FALSE)
    if(NOT NEW_MAJOR STREQUAL LOCAL_MAJOR OR NOT NEW_CML STREQUAL LOCAL_CML)
        set(_major_update TRUE)
    endif()

    message(NOTICE "")
    message(NOTICE "IDI CMake framework update")
    message(NOTICE "  Source:   ${_source_desc}")
    message(NOTICE "  Project:  ${LOCAL_VERSION} (updater ${LOCAL_UPDATER})")
    message(NOTICE "  Incoming: ${NEW_VERSION} (updater ${NEW_UPDATER})")
    if(NOT NEW_CML STREQUAL LOCAL_CML)
        message(NOTICE "  Required CMakeLists versions (root.src.base): ${LOCAL_CML} -> ${NEW_CML}")
    endif()

    set(_status "available")
    if(NEW_VERSION VERSION_LESS LOCAL_VERSION)
        message(NOTICE "")
        message(NOTICE "The incoming framework is OLDER than the project's.")
        set(_status "up-to-date")
    elseif(NOT NEW_VERSION VERSION_GREATER LOCAL_VERSION AND NOT NEW_UPDATER GREATER LOCAL_UPDATER)
        message(NOTICE "")
        message(NOTICE "The project is already up to date.")
        set(_status "up-to-date")
    endif()
    if(_status STREQUAL "up-to-date" AND FORCE)
        message(NOTICE "--force given: the incoming files will be applied anyway.")
        set(_status "forced")
    endif()

    if(NOT _status STREQUAL "up-to-date")
        message(NOTICE "")
        message(NOTICE "Framework-owned paths that will be replaced:")
        foreach(_d IN LISTS MANAGED_DIRS)
            set(_from "")
            set(_to "")
            if(_d STREQUAL "src/base" AND _project)
                set(_from "include/template_project/")
                set(_to "include/${_project}/")
            endif()
            _diff_dir("${_d}" "${ROOT}/${_d}" "${_tree}/${_d}" "${_from}" "${_to}")
        endforeach()
        foreach(_f IN LISTS MANAGED_FILES)
            if(NOT EXISTS "${_tree}/${_f}")
                message(NOTICE "  ${_f}  (missing in the incoming framework)")
            elseif(NOT EXISTS "${ROOT}/${_f}")
                message(NOTICE "  ${_f}  new")
            else()
                file(SHA256 "${ROOT}/${_f}" _a)
                file(SHA256 "${_tree}/${_f}" _b)
                if(_a STREQUAL _b)
                    message(NOTICE "  ${_f}  unchanged")
                else()
                    message(NOTICE "  ${_f}  changed")
                endif()
            endif()
        endforeach()
        message(NOTICE "")
        message(NOTICE "Everything else (platform files, hooks, components, CI, README) is left alone. Project changes")
        message(NOTICE "inside the paths above are overwritten: move them to cmake-hooks/, the platform files or")
        message(NOTICE "your own component before updating.")
        message(NOTICE "")
        message(NOTICE "What's new (cmake/idi/CHANGELOG.md):")
        _print_changelog("${_tree}/cmake/idi/CHANGELOG.md" "${LOCAL_VERSION}" "${NEW_VERSION}")
        if(_major_update)
            message(NOTICE "")
            message(NOTICE "*** This is a MAJOR framework update: read the 'Manual steps' above before building. ***")
        endif()
    endif()

    set(_all_paths ${MANAGED_DIRS} ${MANAGED_FILES})
    list(JOIN _all_paths "\n" _paths_text)
    file(WRITE "${STAGE_DIR}/paths.txt" "${_paths_text}\n")
    _write_status("STATUS=${_status}" "OLD=${LOCAL_VERSION}" "NEW=${NEW_VERSION}" "MAJOR=${_major_update}" "GIT=${_in_git}")
    return()
endif()

# ---------------------------------------------------------------------------
# MODE=apply
# ---------------------------------------------------------------------------
if(MODE STREQUAL "apply")
    if(NOT EXISTS "${_tree}/cmake/idi/updater/updater_version.cmake")
        message(FATAL_ERROR "Nothing staged in ${_tree}; run MODE=stage first")
    endif()
    set(_args -S "${ROOT}" -B "${STAGE_DIR}/apply-build"
        -DDO_FRAMEWORK_UPDATE=ON -DFRAMEWORK_UPDATE_MODE=folder "-DFRAMEWORK_UPDATE_FOLDER_LOC=${_tree}")
    if(FORCE)
        list(APPEND _args -DFRAMEWORK_UPDATE_FORCE=ON)
    endif()
    message(NOTICE "Applying the update ...")
    execute_process(COMMAND "${CMAKE_COMMAND}" ${_args}
        RESULT_VARIABLE _rc OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
    file(REMOVE_RECURSE "${STAGE_DIR}/apply-build" "${ROOT}/.idi-framework-update")
    if(NOT _rc EQUAL 0)
        message(NOTICE "${_out}${_err}")
        message(FATAL_ERROR "The updater failed (output above).")
    endif()
    string(REGEX MATCHALL "Framework update - Done Updating [^\n]*" _done "${_out}")
    foreach(_line IN LISTS _done)
        string(REPLACE "Framework update - Done Updating " "  updated " _line "${_line}")
        message(NOTICE "${_line}")
    endforeach()
    return()
endif()

# ---------------------------------------------------------------------------
# MODE=post (runs from the updated framework)
# ---------------------------------------------------------------------------
if(MODE STREQUAL "post")
    _read_status()
    _read_versions("${ROOT}" NOW)
    file(STRINGS "${STAGE_DIR}/paths.txt" _paths)

    message(NOTICE "")
    message(NOTICE "Framework is now ${NOW_VERSION} (was ${STATUS_OLD}).")
    if(STATUS_GIT AND _git)
        _git_run(_stat diff --stat=100 -- ${_paths})
        _git_run(_untracked ls-files --others --exclude-standard -- ${_paths})
        if(_stat)
            message(NOTICE "")
            message(NOTICE "Changed files:")
            message(NOTICE "${_stat}")
        endif()
        if(_untracked)
            string(REPLACE "\n" ";" _untracked "${_untracked}")
            list(LENGTH _untracked _n)
            message(NOTICE "New files: ${_n}")
        endif()
        if(NOT _stat AND NOT _untracked)
            message(NOTICE "No file changes.")
        endif()
        list(JOIN _paths " " _path_args)
        message(NOTICE "")
        message(NOTICE "Review:   git diff -- ${_path_args}")
        message(NOTICE "Rollback: git checkout -- ${_path_args} && git clean -fd -- ${_path_args}")
    endif()
    if(STATUS_MAJOR)
        message(NOTICE "")
        message(NOTICE "*** MAJOR update: apply the 'Manual steps' from cmake/idi/CHANGELOG.md to your project files. ***")
    endif()
    return()
endif()

message(FATAL_ERROR "update_workflow.cmake: unknown MODE '${MODE}' (stage, apply, post)")
